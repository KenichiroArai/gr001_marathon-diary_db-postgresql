<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>kmg.gr.gr001</groupId>
    <artifactId>gr001_marathon-diary_db-postgresql</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>gr001_marathon-diary_db-postgresql</name>
    <description>マラソン日記のDB（PostgreSQL）アクセス</description>

    <properties>
        <java.version>25</java.version>
        <kmg-core.version>0.3.1</kmg-core.version>
        <kmg-fund.version>0.3.1</kmg-fund.version>
        <dbflute.version>1.3.1</dbflute.version>
        <dbflute-maven-plugin.version>1.1.0</dbflute-maven-plugin.version>

        <!-- DBFlute（ReplaceSchema / Generate）の接続先。docker-compose.yml / .env.example と揃える -->
        <dbflute.clientProject>marathondiary</dbflute.clientProject>
        <dbflute.packageBase>kmg.gr.gr001.db.postgresql.dbflute</dbflute.packageBase>
        <dbflute.database>postgresql</dbflute.database>
        <dbflute.databaseDriver>org.postgresql.Driver</dbflute.databaseDriver>
        <dbflute.databaseUrl>jdbc:postgresql://localhost:5432/marathondiary</dbflute.databaseUrl>
        <dbflute.databaseSchema>public</dbflute.databaseSchema>
        <dbflute.databaseUser>marathondiary</dbflute.databaseUser>
        <dbflute.databasePassword>marathondiary</dbflute.databasePassword>
    </properties>

    <dependencies>
        <!-- KMG Core -->
        <dependency>
            <groupId>kmg.core</groupId>
            <artifactId>kmg-core</artifactId>
            <version>${kmg-core.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- KMG Fund -->
        <dependency>
            <groupId>kmg.fund</groupId>
            <artifactId>kmg-fund</artifactId>
            <version>${kmg-fund.version}</version>
        </dependency>

        <!-- Spring JDBC（DataSource / トランザクション。Web / Tomcat は含めない） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- DBFlute Runtime -->
        <dependency>
            <groupId>org.dbflute</groupId>
            <artifactId>dbflute-runtime</artifactId>
            <version>${dbflute.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC ドライバ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- テスト -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JUnitテストレポート用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <reportFormat>plain</reportFormat>
                </configuration>
            </plugin>

            <!-- カバレッジレポート用 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <!-- DBFlute の自動生成コードはカバレッジ対象外 -->
                    <excludes>
                        <exclude>kmg/gr/gr001/db/postgresql/dbflute/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Eclipseと共有するためのファイル設定 -->
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.0</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>METHOD</element>
                                    <limits>
                                        <limit>
                                            <counter>COMPLEXITY</counter>
                                            <value>TOTALCOUNT</value>
                                            <maximum>15</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- DBFlute（mvn dbflute:download / create-client / replace-schema / generate） -->
            <plugin>
                <groupId>org.dbflute</groupId>
                <artifactId>dbflute-maven-plugin</artifactId>
                <version>${dbflute-maven-plugin.version}</version>
                <configuration>
                    <dbfluteVersion>${dbflute.version}</dbfluteVersion>
                    <clientProject>${dbflute.clientProject}</clientProject>
                    <packageBase>${dbflute.packageBase}</packageBase>
                    <database>${dbflute.database}</database>
                    <databaseDriver>${dbflute.databaseDriver}</databaseDriver>
                    <databaseUrl>${dbflute.databaseUrl}</databaseUrl>
                    <databaseSchema>${dbflute.databaseSchema}</databaseSchema>
                    <databaseUser>${dbflute.databaseUser}</databaseUser>
                    <databasePassword>${dbflute.databasePassword}</databasePassword>
                    <targetLanguage>java</targetLanguage>
                    <targetContainer>spring</targetContainer>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-kmg-core</id>
            <name>GitHub KenichiroArai Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/KenichiroArai/kmg-core</url>
        </repository>
        <repository>
            <id>github-kmg-fund</id>
            <name>GitHub KenichiroArai Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/KenichiroArai/kmg-fund</url>
        </repository>
    </repositories>

</project>
