# 開発用の PostgreSQL 接続設定（cp .env.example .env で利用する）
# 値を変更した場合は pom.xml の dbflute.database* プロパティも合わせる
POSTGRES_DB=marathondiary
POSTGRES_USER=marathondiary
POSTGRES_PASSWORD=marathondiary
POSTGRES_PORT=5432

# 開発用の pgAdmin 4 ログイン設定（http://localhost:5050）
# ログイン情報は pgadmin-data ボリュームの初回作成時のみ反映される
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
